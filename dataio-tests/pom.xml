<?xml version="1.0" encoding="UTF-8"?>
<!--
  ┌─ What : dataio-tests —— joinery 数据导入导出/计算/图表/中文 独立测试包
  │  Why  : 用户要求测试代码「单独的包」，不能塞进 joinery/src/test（joinery 要发回 git 不能改原测试结构）。
  │         本模块独立 pom、独立包名 dataio.*，依赖 joinery 主工程的官方坐标 sh.joinery:joinery-dataframe。
  │  Who  : 由开发者/CI 在 joinery 主工程 mvn install 后运行
  │  When : 验证 joinery 数据导入导出能力时
  │  Where: dataio-tests/ 子目录
  │  How  : 见各 TestCase 类
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>sh.joinery</groupId>
  <artifactId>dataio-tests</artifactId>
  <version>1.11-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Joinery Data IO Tests</name>
  <description>独立测试包：覆盖 CSV / XLS / XLSX / H2 / SQL 下推聚合 / 图表 / 中文支持</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>

    <!-- 依赖版本：与 joinery 主工程 pom 保持一致，全部官方坐标 -->
    <joinery.version>1.11-SNAPSHOT</joinery.version>
    <poi.version>5.5.1</poi.version>
    <h2.version>2.4.240</h2.version>
    <junit.version>5.13.4</junit.version>
    <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
  </properties>

  <dependencies>
    <!-- 被测对象：joinery 主工程（需先在主工程执行 mvn install 把 1.11-SNAPSHOT 装入本地仓库） -->
    <dependency>
      <groupId>sh.joinery</groupId>
      <artifactId>joinery-dataframe</artifactId>
      <version>${joinery.version}</version>
    </dependency>

    <!-- Excel 读写所需 POI（与主工程同版本；CSV/SQL 测试不依赖它） -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <!-- H2：嵌入式 SQL 数据库，用于测试 readSqlTable/writeSqlTable，并以 MODE=Oracle/MySQL/PostgreSQL 模拟方言 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>

    <!-- ┌─ What : 首批六方言对应的真实 JDBC 驱动（test scope，验证 Engine.fromUrl 识别 + 真实读写） -->
    <!-- │  Oracle ojdbc 不在 Maven Central 公开仓库，仍用 H2 MODE=Oracle 模拟，不在此引入 -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.2.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>9.7.0</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 5（现代化，与主工程 JUnit 4 解耦） -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
